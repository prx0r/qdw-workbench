{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QDW Workbench",
  "version": "0.1.0",
  "identifier": "org.qdw.workbench",
  "build": {
    "beforeDevCommand": "npm run dev --prefix web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "QDW Workbench",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
